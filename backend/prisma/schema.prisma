generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Landlord {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  passwordHash String     @map("password_hash")
  phoneNumber  String     @map("phone_number") @db.VarChar(15)
  createdAt    DateTime   @default(now()) @map("created_at")
  properties   Property[]

  @@map("landlords")
}

model Property {
  id         Int      @id @default(autoincrement())
  landlordId Int      @map("landlord_id")
  name       String   @db.VarChar(100)
  address    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  landlord           Landlord            @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  rooms              Room[]
  tenants            Tenant[]
  tenantApplications TenantApplication[]
  expenses           Expense[]
  maintenanceTicket  MaintenanceTicket[]

  @@map("properties")
}

model Room {
  id                 Int      @id @default(autoincrement())
  propertyId         Int      @map("property_id")
  floorNumber        Int      @default(0) @map("floor_number")
  roomNumber         String   @map("room_number") @db.VarChar(20)
  roomType           String   @default("Shared") @map("room_type") @db.VarChar(50)
  baseRent           Decimal  @map("base_rent") @db.Decimal(10, 2)
  latestMeterReading Decimal  @default(0.00) @map("latest_meter_reading") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds               Bed[]
  tenantApplications TenantApplication[]

  @@map("rooms")
}

model Bed {
  id         Int      @id @default(autoincrement())
  roomId     Int      @map("room_id")
  bedNumber  String   @map("bed_number") @db.VarChar(10)
  isOccupied Boolean  @default(false) @map("is_occupied")
  createdAt  DateTime @default(now()) @map("created_at")

  room               Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenants            Tenant[]
  tenantApplications TenantApplication[]

  @@map("beds")
}

model Tenant {
  id               Int       @id @default(autoincrement())
  propertyId       Int       @map("property_id")
  bedId            Int?      @map("bed_id")
  name             String    @db.VarChar(100)
  phoneNumber      String    @map("phone_number") @db.VarChar(15)
  emergencyContact String?   @map("emergency_contact") @db.VarChar(15)
  idProofUrl       String?   @map("id_proof_url") @db.Text
  status           String    @default("Active") @db.VarChar(20)
  joiningDate      DateTime  @map("joining_date") @db.Date
  leavingDate      DateTime? @map("leaving_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bed      Bed?      @relation(fields: [bedId], references: [id], onDelete: SetNull)
  invoices Invoice[]

  @@map("tenants")
}

model TenantApplication {
  id               Int      @id @default(autoincrement())
  propertyId       Int      @map("property_id")
  roomId           Int?     @map("room_id")
  bedId            Int?     @map("bed_id")
  name             String   @db.VarChar(100)
  phoneNumber      String   @map("phone_number") @db.VarChar(15)
  emergencyContact String?  @map("emergency_contact") @db.VarChar(15)
  idProofUrl       String?  @map("id_proof_url") @db.Text
  status           String   @default("Pending") @db.VarChar(20)
  proposedJoinDate DateTime @map("proposed_join_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bed      Bed?     @relation(fields: [bedId], references: [id], onDelete: SetNull)

  @@map("tenant_applications")
}

model Invoice {
  id                     Int       @id @default(autoincrement())
  tenantId               Int       @map("tenant_id")
  billingPeriodStart     DateTime  @map("billing_period_start") @db.Date
  billingPeriodEnd       DateTime  @map("billing_period_end") @db.Date
  baseRentCharged        Decimal   @map("base_rent_charged") @db.Decimal(10, 2)
  previousMeterReading   Decimal   @map("previous_meter_reading") @db.Decimal(10, 2)
  currentMeterReading    Decimal   @map("current_meter_reading") @db.Decimal(10, 2)
  electricityRatePerUnit Decimal   @map("electricity_rate_per_unit") @db.Decimal(5, 2)
  electricityTotal       Decimal   @map("electricity_total") @db.Decimal(10, 2)
  additionalCharges      Decimal   @default(0.00) @map("additional_charges") @db.Decimal(10, 2)
  totalAmountDue         Decimal   @map("total_amount_due") @db.Decimal(10, 2)
  paymentStatus          String    @default("Pending") @map("payment_status") @db.VarChar(20)
  paymentMode            String?   @map("payment_mode") @db.VarChar(20)
  paidAt                 DateTime? @map("paid_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Expense {
  id         Int      @id @default(autoincrement())
  propertyId Int      @map("property_id")
  title      String
  category   String
  amount     Decimal  @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model MaintenanceTicket {
  id          Int      @id @default(autoincrement())
  propertyId  Int      @map("property_id")
  roomNumber  String   @map("room_number") @db.VarChar(10)
  category    String   @db.VarChar(50)
  description String   @db.Text
  severity    String   @default("Medium") @db.VarChar(15) // Low, Medium, High
  status      String   @default("Open") @db.VarChar(20) // Open, In Progress, Resolved
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relational Map bindings
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("maintenance_tickets")
}
